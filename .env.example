# Vorlage - als ".env" kopieren und ausfuellen. Die .env gehoert nicht ins Git.
# Nur LESENDER Zugriff auf Zoho Inventory wird benoetigt (Scope
# ZohoInventory.READ). Fuer den Refresh Token siehe README.md.

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# KRESSEMANN | Inh. Philip Diehl
ZOHO_ORGANIZATION_ID=20099365526

# EU-Rechenzentrum (accounts.zoho.eu / zohoapis.eu)
ZOHO_REGION=eu

# GSMtasks - Verbindungstest + manuelle Uebertragung fertiger Tourentwuerfe
# als drop_off-Tasks (routeplanning/gsmtasks.py). Uebertragung erfolgt nur
# nach expliziter Bestaetigung im Web, nie automatisch.
GSMTASKS_API_KEY=

# Fester Fahrer fuer neu angelegte GSMtasks-Aufgaben. Produktiv in
# compose.yaml gesetzt; hier nur fuer lokale Laeufe ohne Compose. Fehlt einer
# der Werte, wird nichts uebertragen.
# GSMTASKS_ASSIGNEE_USER_ID=b47e7f7c-6e71-436c-8305-e7a0b6b2e1f9
# GSMTASKS_ASSIGNEE_NAME=Kressemann
